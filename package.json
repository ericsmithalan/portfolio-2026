{
    "name": "portfolio",
    "version": "0.1.0",
    "private": true,
    "dependencies": {
        "clsx": "^2.1.1",
        "react": "^19.3.0",
        "react-dom": "^19.3.0"
    },
    "devDependencies": {
        "@types/node": "^22.20.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "prettier": "^3.9.6",
        "turbo": "^2.10.12",
        "typescript": "6.0.3"
    },
    "packageManager": "pnpm@10.33.4",
    "workspaces": [
        "apps/*",
        "lib/*"
    ],
    "scripts": {
        "start": "turbo run start",
        "dev": "turbo run dev",
        "build": "turbo run build",
        "format": "turbo run format",
        "clean": "find . -type d \\( -name \"node_modules\" -o -name \"dist\"  -o -name \".turbo\" \\) -prune -exec rm -rf {} +"
    },
    "framework": "vite",
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    },
    "pnpm": {
        "overrides": {
            "@types/react": "19.3.0",
            "@types/react-dom": "19.3.0",
            "rollup-plugin-dts": "^6.1.1"
        },
        "ignoredBuiltDependencies": [
            "core-js"
        ],
        "onlyBuiltDependencies": [
            "@parcel/watcher",
            "esbuild"
        ]
    }
}
