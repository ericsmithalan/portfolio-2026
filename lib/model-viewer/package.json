{
    "name": "@portfolio/model-viewer",
    "version": "1.0.0",
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "private": "true",
    "scripts": {
        "build": "tsup --tsconfig tsconfig.build.json",
        "dev": "tsup --tsconfig tsconfig.build.json --watch",
        "format": "prettier --cache --write \"src/**/*.{ts,tsx,css,scss,json,md}\"",
        "typecheck": "tsc --noEmit"
    },
    "files": [
        "dist"
    ],
    "exports": {
        "./styles.css": "./dist/index.css",
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.mjs"
            },
            "require": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            }
        }
    },
    "dependencies": {
        "@tweenjs/tween.js": "^25.0.0",
        "react-router-dom": "^7.18.3",
        "three": "^0.186.0",
        "three-viewport-gizmo": "^2.2.0",
        "tsup": "^8.5.1",
        "tsx": "^4.23.13"
    },
    "peerDependencies": {
        "@types/node": "^22.20.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "clsx": "^2.1.1",
        "prettier": "^3.9.6",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "tailwind": "^4.0.0",
        "typescript": "6.0.3"
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    },
    "devDependencies": {
        "@microsoft/api-extractor": "^7.59.1",
        "@types/three": "^0.186.0",
        "esbuild-sass-plugin": "^3.7.0",
        "sass": "^1.104.0"
    }
}
